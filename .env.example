# ShortcutsBridge configuration. Copy to .env.local and fill in.
# NEVER commit .env.local (it is gitignored). Placeholders only in this file.

# ── Server (set these on Vercel for the hosted relay; local for self-hosting) ──
# Supabase project backing the KV (nb_* RPCs). Shared across the Mac Bridge family.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Secret used to sign OAuth/session/agent JWTs. Generate: openssl rand -hex 32
JWT_SECRET=change-me

# Reviewer/demo account password (email is reviewer@shortcutsbridge.demo).
DEMO_PASSWORD=change-me

# ── Kit / e2e (kit/register-connector.mjs, test/e2e-oauth.mjs) ──
NB_SERVER=https://shortcutsbridge.vercel.app
# The ShortcutsBridge account the connector signs in as (the demo account).
NB_EMAIL=reviewer@shortcutsbridge.demo
NB_PASSWORD=your-shortcutsbridge-password
